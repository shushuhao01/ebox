# eBox 授权服务平台后端环境配置示例
# 复制为 .env 并按实际修改（生产环境；开发环境可用 .env.local）
# 注意：.env 包含私钥，务必加入 .gitignore，禁止提交！

# 服务端口（Nginx 反代 443 -> 3008）
PORT=3008
NODE_ENV=production

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=license
DB_PASSWORD=请修改为强密码
DB_DATABASE=license_server

# 管理接口 JWT
JWT_SECRET=请修改为随机长字符串
JWT_EXPIRES=7d

# ────────────────────────────────────────────────
# ECDSA P-256 私钥标量 d（hex，64 位十六进制字符）
# 必须与 eBox 客户端内置公钥配对！
# 运行  npm run gen:key  可查看当前配置的密钥信息 / 生成建议
# 默认出厂密钥（与 eBox 客户端内置公钥配套）：
# LICENSE_PRIVATE_KEY_D=1e34ab0973d3c60a02c1fdae954c4d4d9492084fafb6428a17a86991a277d66e
# ────────────────────────────────────────────────
LICENSE_PRIVATE_KEY_D=1e34ab0973d3c60a02c1fdae954c4d4d9492084fafb6428a17a86991a277d66e

# CORS 白名单（逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
