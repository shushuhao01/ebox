{
  "name": "license-server-backend",
  "version": "1.0.0",
  "description": "eBox 授权服务平台后端 API（客户端接口 + 管理面板接口）",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/app.ts\"",
    "dev:local": "cross-env NODE_ENV=development nodemon --watch src --ext ts --exec \"ts-node src/app.ts\"",
    "build": "tsc",
    "start": "node dist/app.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "init:db": "ts-node src/scripts/init-db.ts",
    "gen:key": "ts-node src/scripts/gen-key.ts",
    "init:admin": "ts-node src/scripts/init-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.20.0",
    "node-cron": "^4.2.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.28",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
